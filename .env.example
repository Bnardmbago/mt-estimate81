POSTGRES_USER=estimate
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_estimate
DATABASE_URL=postgresql+asyncpg://estimate:change_me@db:5432/ai_estimate

JWT_SECRET=change_me_to_random_64_chars
JWT_EXPIRY_HOURS=8

AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# API keys and provider can also be configured in Admin → AI credentials (stored in database).

HERMES_URL=http://hermes:8080
STORAGE_BACKEND=local
STORAGE_PATH=/data

DEFAULT_LOCALE=ja
APP_ENV=development
COOKIE_SECURE=false
COMPOSE_PROJECT_NAME=ai-estimate-mvp
NEXT_PUBLIC_API_URL=http://api:8000

