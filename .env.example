POSTGRES_USER=estimate
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_estimate
DATABASE_URL=postgresql+asyncpg://estimate:change_me@db:5432/ai_estimate

JWT_SECRET=change_me_to_random_64_chars
JWT_EXPIRY_HOURS=8

AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# API keys and provider can also be configured in Admin → AI settings (stored in database).

HERMES_URL=http://hermes:8080
STORAGE_BACKEND=local
STORAGE_PATH=/data

DEFAULT_LOCALE=ja
APP_ENV=development
COOKIE_SECURE=false
COMPOSE_PROJECT_NAME=ai-estimate-mvp
NEXT_PUBLIC_API_URL=http://api:8000

# Quotation PDF (見積書) — sender block, payment terms, bank details
QUOTATION_COMPANY_NAME=MTECH Corporation
QUOTATION_COMPANY_BRAND=MTECH
QUOTATION_COMPANY_POSTAL_CODE=
QUOTATION_COMPANY_ADDRESS=
QUOTATION_COMPANY_TEL=
QUOTATION_COMPANY_EMAIL=
QUOTATION_INVOICE_REGISTRATION_NUMBER=
QUOTATION_PAYMENT_TERMS_JA=納品後30日以内
QUOTATION_PAYMENT_TERMS_EN=Within 30 days after delivery
QUOTATION_VALIDITY_DAYS=30
QUOTATION_BANK_DETAILS_JA=
QUOTATION_BANK_DETAILS_EN=
QUOTATION_REMARKS_JA=ご検討のほど、よろしくお願い申し上げます。
QUOTATION_REMARKS_EN=Thank you for your consideration.

# SMTP (export email attachments — can also be set in Admin → SMTP settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
