<!DOCTYPE html>
<html lang="{{ ctx.locale }}">
<head>
  <meta charset="utf-8">
  <title>{{ ctx.labels.title }}</title>
  <style>
    {% include '_export_theme.css.j2' %}

    @page {
      size: A4;
      margin: 14mm 12mm 16mm 12mm;
    }

    @font-face {
      font-family: "Noto Sans JP";
      src: local("Noto Sans CJK JP"), local("Noto Sans JP");
    }

    * { box-sizing: border-box; }

    body {
      font-family: "Noto Sans JP", "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
      font-size: 8.5pt;
      line-height: 1.35;
      color: var(--export-text);
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .num { text-align: right; white-space: nowrap; }

    /* Header row: title + meta table */
    .header-row { display: table; width: 100%; margin-bottom: 6pt; }
    .header-left { display: table-cell; vertical-align: top; width: 50%; }
    .header-right { display: table-cell; vertical-align: top; width: 50%; text-align: right; }

    .doc-title {
      font-size: 22pt;
      font-weight: 700;
      margin: 0;
      line-height: 1.1;
      color: var(--export-text);
    }

    .meta-table {
      border-collapse: collapse;
      margin: 0 0 0 auto;
      font-size: 8pt;
    }

    .meta-table th {
      font-weight: 600;
      text-align: right;
      padding: 1pt 4pt 1pt 0;
      white-space: nowrap;
      color: var(--export-text);
      background: transparent;
      border: none;
    }

    .meta-table td {
      text-align: left;
      padding: 1pt 0 1pt 2pt;
      min-width: 80pt;
      border: none;
    }

    /* Parties row: client/project + company block */
    .parties-row { display: table; width: 100%; margin-bottom: 6pt; }
    .parties-left { display: table-cell; vertical-align: top; width: 48%; padding-right: 8pt; }
    .parties-right { display: table-cell; vertical-align: top; width: 52%; text-align: right; }

    .client-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5pt;
      margin-bottom: 4pt;
    }

    .client-table th {
      font-weight: 600;
      text-align: left;
      padding: 2pt 6pt 2pt 0;
      white-space: nowrap;
      width: 28%;
      color: var(--export-text);
      background: transparent;
      border: none;
    }

    .client-table td {
      padding: 2pt 0;
      border: none;
      border-bottom: 0.5pt solid var(--export-border);
    }

    .intro { font-size: 8.5pt; margin: 4pt 0 0; }

    .company-block { display: inline-block; text-align: left; max-width: 100%; }
    .brand-logo-img {
      height: 24pt;
      width: auto;
      display: block;
      margin-bottom: 4pt;
    }

    .company-detail { font-size: 7.5pt; line-height: 1.45; margin-top: 2pt; }
    .contact-person-line { margin-bottom: 2pt; }
    .company-contact { white-space: pre-line; }

    .header-divider {
      border: none;
      border-bottom: 2pt solid var(--export-primary);
      margin: 0 0 8pt;
    }

    /* Total amount band */
    .total-band {
      width: 50%;
      border: 1pt solid var(--export-border);
      padding: 6pt 10pt;
      margin-bottom: 8pt;
      text-align: left;
    }

    .total-band-label {
      font-size: 9pt;
      font-weight: 600;
      margin-bottom: 2pt;
      color: var(--export-text);
    }

    .total-band-amount {
      font-size: 16pt;
      font-weight: 700;
      color: var(--export-primary);
    }

    /* Line items table */
    .items-wrap {
      border: 0.75pt solid var(--export-border);
      margin-bottom: 6pt;
    }

    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin: 0;
      font-size: 8pt;
    }

    .items-table thead th {
      background: var(--export-primary);
      color: var(--export-text-on-primary);
      font-weight: 600;
      padding: 4pt 6pt;
      border: none;
      text-align: left;
      font-size: 8pt;
    }

    .items-table thead th.col-unit,
    .items-table thead th.col-price,
    .items-table thead th.col-sub { text-align: center; }
    .items-table thead th.col-price,
    .items-table thead th.col-sub { text-align: right; }

    .items-table tbody td {
      padding: 4pt 6pt;
      border: none;
      border-bottom: 0.5pt solid var(--export-border);
      vertical-align: middle;
    }

    .items-table tbody tr:nth-child(odd) td { background: var(--export-surface); }
    .items-table tbody tr:nth-child(even) td { background: #fff; }
    .items-table tbody tr.empty-row td { height: 18pt; }

    .items-table .col-item { text-align: left; width: 46%; }
    .items-table .col-unit { text-align: center; width: 12%; }
    .items-table .col-price { text-align: right; width: 21%; }
    .items-table .col-sub { text-align: right; width: 21%; }

    /* Summary row: notes + totals */
    .summary-row { display: table; width: 100%; margin-bottom: 6pt; }
    .summary-notes { display: table-cell; vertical-align: top; width: 54%; padding-right: 8pt; }
    .summary-totals { display: table-cell; vertical-align: top; width: 46%; }

    .notes-heading {
      font-size: 8.5pt;
      font-weight: 700;
      margin: 0 0 3pt;
      color: var(--export-text);
    }

    .remarks-box {
      border: 0.75pt solid var(--export-border);
      padding: 6pt 8pt;
      min-height: 52pt;
      white-space: pre-wrap;
      line-height: 1.35;
      font-size: 8pt;
      background: #fff;
    }

    .totals-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8pt;
    }

    .totals-table th {
      font-weight: 600;
      padding: 4pt 6pt;
      text-align: left;
      border: none;
      border-bottom: 0.5pt solid var(--export-border);
      background: var(--export-primary-light);
      color: var(--export-text);
    }

    .totals-table td {
      padding: 4pt 6pt;
      text-align: right;
      border: none;
      border-bottom: 0.5pt solid var(--export-border);
      background: #fff;
    }

    .totals-table tr.grand-total th,
    .totals-table tr.grand-total td {
      font-weight: 700;
      background: var(--export-primary-light) !important;
      color: var(--export-text);
    }

    /* Payment + bank footer */
    .payment-footer {
      margin-top: 4pt;
      margin-bottom: 8pt;
    }

    .payment-header-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8pt;
      font-weight: 600;
      margin: 0;
    }

    .payment-header-table td {
      border: 0.75pt solid var(--export-border);
      padding: 4pt 8pt;
      vertical-align: middle;
    }

    .payment-header-table .payment-label {
      width: 50%;
      text-align: left;
    }

    .payment-header-table .payment-due {
      width: 50%;
      text-align: left;
    }

    /* Bank details box */
    .bank-box {
      border: 0.75pt solid var(--export-border);
      border-top: none;
      padding: 8pt 10pt;
      margin: 0 0 8pt;
      font-size: 8pt;
      white-space: pre-wrap;
      line-height: 1.5;
      background: #fff;
      min-height: 28pt;
    }

    /* Bottom footer bar */
    .footer-bar {
      border: none;
      border-top: 4pt solid var(--export-primary);
      margin: 0;
      height: 0;
    }

    {% if show_watermark %}
    {% include '_watermark.css.j2' %}
    {% endif %}
  </style>
</head>
<body>
  {% if show_watermark %}
  <div class="contact-watermark">Contact Estimate</div>
  {% endif %}

  <div class="header-row">
    <div class="header-left">
      <h1 class="doc-title">{{ ctx.labels.title }}</h1>
    </div>
    <div class="header-right">
      <table class="meta-table">
        <tr>
          <th>{{ ctx.labels.issue_date }}：</th>
          <td>{{ ctx.issue_date }}</td>
        </tr>
        <tr>
          <th>{{ ctx.labels.quote_number }}：</th>
          <td></td>
        </tr>
        <tr>
          <th>{{ ctx.labels.registration_number }}：</th>
          <td></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="parties-row">
    <div class="parties-left">
      <table class="client-table">
        <tr>
          <th>{{ ctx.labels.project_name }}：</th>
          <td>{{ ctx.project_name }}</td>
        </tr>
        <tr>
          <th>{{ ctx.labels.client }}：</th>
          <td>{{ ctx.client_name }}</td>
        </tr>
      </table>
      <p class="intro">{{ ctx.intro }}</p>
    </div>
    <div class="parties-right">
      <div class="company-block">
        <img class="brand-logo-img" src="assets/BI_logo.svg" alt="Beyond AI">
        <div class="company-detail">
          <div class="contact-person-line">{{ ctx.labels.contact_person }}：{% if ctx.company.contact_person %}{{ ctx.company.contact_person }}{% endif %}</div>
          <div class="company-contact">{{ ctx.company.contact_block }}</div>
        </div>
      </div>
    </div>
  </div>

  <hr class="header-divider">

  <div class="total-band">
    <div class="total-band-label">［{{ ctx.labels.total_amount_label }}］</div>
    <div class="total-band-amount">{{ format_currency(ctx.grand_total_jpy) }}</div>
  </div>

  <div class="items-wrap">
    <table class="items-table">
      <thead>
        <tr>
          <th class="col-item">{{ ctx.labels.item }}</th>
          <th class="col-unit">{{ ctx.labels.unit }}</th>
          <th class="col-price">{{ ctx.labels.unit_price }}</th>
          <th class="col-sub">{{ ctx.labels.subtotal_col }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in ctx.line_items %}
          <tr>
            <td class="col-item">{{ row.name }}</td>
            <td class="col-unit">{{ row.unit }}</td>
            <td class="col-price num">{{ format_currency(row.unit_price_jpy) }}</td>
            <td class="col-sub num">{{ format_currency(row.subtotal_jpy) }}</td>
          </tr>
        {% endfor %}
        {% set min_rows = 6 %}
        {% set empty_count = min_rows - ctx.line_items|length %}
        {% if empty_count > 0 %}
          {% for i in range(empty_count) %}
            <tr class="empty-row">
              <td class="col-item">&nbsp;</td>
              <td class="col-unit"></td>
              <td class="col-price"></td>
              <td class="col-sub"></td>
            </tr>
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>

  <div class="summary-row">
    <div class="summary-notes">
      <div class="notes-heading">{{ ctx.labels.notes_heading }}</div>
      <div class="remarks-box">{{ ctx.remarks }}</div>
    </div>
    <div class="summary-totals">
      <table class="totals-table">
        <tr>
          <th>{{ ctx.labels.subtotal }}：</th>
          <td>{{ format_currency(ctx.subtotal_jpy) }}</td>
        </tr>
        <tr>
          <th>{{ ctx.tax_with_rate_label }}：</th>
          <td>{{ format_currency(ctx.tax_jpy) }}</td>
        </tr>
        <tr class="grand-total">
          <th>{{ ctx.labels.grand_total }}：</th>
          <td>{{ format_currency(ctx.grand_total_jpy) }}</td>
        </tr>
      </table>
    </div>
  </div>

  <div class="payment-footer">
    <table class="payment-header-table">
      <tr>
        <td class="payment-label">{{ ctx.labels.bank_details }}</td>
        <td class="payment-due">{{ ctx.labels.payment_due }} {{ ctx.payment_terms }}</td>
      </tr>
    </table>
    <div class="bank-box">{{ ctx.bank_details }}</div>
  </div>

  <hr class="footer-bar">
</body>
</html>
