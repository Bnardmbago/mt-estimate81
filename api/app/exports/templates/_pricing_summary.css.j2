{% if ctx.pricing_summary.has_discount %}
.pricing-summary {
  border: 0.75pt solid var(--export-border);
  padding: 8pt 10pt;
  margin-bottom: 8pt;
  font-size: 8.5pt;
  line-height: 1.5;
  background: var(--export-surface);
}
.pricing-summary-row {
  display: table;
  width: 100%;
  margin-bottom: 2pt;
}
.pricing-summary-label {
  display: table-cell;
  width: 42%;
  font-weight: 600;
}
.pricing-summary-value {
  display: table-cell;
  text-align: right;
}
.pricing-summary-special {
  font-size: 10pt;
  font-weight: 700;
  color: var(--export-primary);
}
.pricing-campaign {
  margin-top: 6pt;
  padding-top: 6pt;
  border-top: 0.5pt solid var(--export-border);
  font-size: 8pt;
  white-space: pre-wrap;
}
.pricing-campaign-title {
  font-weight: 700;
  margin-bottom: 2pt;
}
{% endif %}
