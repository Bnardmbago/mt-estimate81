{% if ctx.questionnaire_sections %}
<div class="questionnaire-appendix">
  <h2 class="appendix-title">{{ ctx.questionnaire_appendix_title }}</h2>
  {% for section in ctx.questionnaire_sections %}
    <h3 class="appendix-section-title">{{ section.title }}</h3>
    <table class="qa-table">
      <tbody>
        {% for field in section.fields %}
          <tr>
            <th>{{ field.label }}</th>
            <td>{{ field.value }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endfor %}
</div>
{% endif %}
