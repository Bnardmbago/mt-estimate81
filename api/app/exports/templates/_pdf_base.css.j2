@page {
  size: A4;
  margin: 14mm 12mm 16mm 12mm;
}

@font-face {
  font-family: "Noto Sans JP";
  src: local("Noto Sans CJK JP"), local("Noto Sans JP");
}

* { box-sizing: border-box; }

body {
  font-family: "Noto Sans JP", "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  font-size: 8.5pt;
  line-height: 1.35;
  color: var(--export-text);
  margin: 0;
  padding: 0;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

h1 {
  font-size: 12pt;
  font-weight: 700;
  margin: 0 0 8pt;
  color: var(--export-text-on-primary);
  background: var(--export-primary);
  padding: 6pt 10pt;
  border-radius: 3pt;
}

h2, .section-title {
  font-size: 10pt;
  font-weight: 600;
  color: var(--export-primary);
  margin: 0 0 3pt;
  padding-bottom: 2pt;
  border-bottom: 0.75pt solid var(--export-border);
  background: transparent;
  page-break-after: avoid;
}

h3, .section-subtitle {
  font-size: 9pt;
  font-weight: 600;
  color: var(--export-text);
  margin: 3pt 0 2pt;
  page-break-after: avoid;
}

p { margin: 0 0 3pt; }

ul {
  margin: 0 0 3pt;
  padding-left: 12pt;
  font-size: 8pt;
  list-style-type: disc;
}

li { margin: 0; padding: 0; line-height: 1.25; }

.section {
  margin-bottom: 4pt;
  page-break-inside: auto;
  break-inside: auto;
}

.section-card {
  border: 0.75pt solid var(--export-border);
  border-radius: 4pt;
  padding: 5pt 7pt 4pt;
  margin-bottom: 4pt;
  page-break-inside: auto;
  break-inside: auto;
}

.section-card h2 {
  margin-top: 0;
  margin-bottom: 2pt;
}

.section-card > table:last-child {
  margin-bottom: 0;
}

.section-card .req-group {
  margin: 0;
  padding: 0;
}

.section-card .req-group h3 {
  margin: 2pt 0 0;
  padding: 0;
  border: none;
}

.section-card .req-group:first-of-type h3 {
  margin-top: 0;
}

.section-card .req-group ul {
  margin: 0 0 1pt;
  padding-left: 10pt;
}

.section-card .req-group ul li {
  margin: 0;
  line-height: 1.25;
}

.section-card .req-group ul li:last-child {
  margin-bottom: 0;
}

h2 + table,
h3 + table,
h2 + .req-group,
p + table,
table + p,
table + h2,
table + h3,
ul + .req-group {
  margin-top: 0;
}

.muted {
  color: var(--export-muted);
  font-style: italic;
  font-size: 7.5pt;
}

.note {
  font-size: 7.5pt;
  color: var(--export-muted);
  margin: 0 0 5pt;
  padding: 4pt 8pt;
  background: var(--export-surface);
  border-left: 2pt solid var(--export-accent);
  border-radius: 0 3pt 3pt 0;
  line-height: 1.35;
}

.field-value {
  margin: 0 0 4pt;
  white-space: pre-wrap;
  font-size: 8pt;
  line-height: 1.35;
}

.num { text-align: right; white-space: nowrap; }

/* Standard data tables */
.data-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin: 0;
  font-size: 8pt;
  border: 0.75pt solid var(--export-border);
  border-radius: 3pt;
}

.data-table thead { display: table-header-group; }

.data-table tr {
  page-break-inside: avoid;
  break-inside: avoid;
}

.qa-table tr {
  page-break-inside: avoid;
  break-inside: avoid;
}

.data-table th {
  background: var(--export-primary);
  color: var(--export-text-on-primary);
  font-weight: 600;
  padding: 4pt 6pt;
  text-align: left;
  border: none;
  border-bottom: 0.5pt solid var(--export-border);
}

.data-table td {
  padding: 4pt 6pt;
  border: none;
  border-bottom: 0.5pt solid var(--export-border);
  vertical-align: top;
}

.data-table tbody tr:last-child td,
.data-table tbody tr:last-child th {
  border-bottom: none;
}

.data-table tbody tr:nth-child(even) td { background: var(--export-surface); }
.data-table tbody tr:nth-child(odd) td { background: #fff; }

.data-table .total-row td,
.data-table .total-row th {
  font-weight: 700;
  background: var(--export-primary-light) !important;
  border-top: 0.75pt solid var(--export-border);
  color: var(--export-text);
}

.data-table .first-year-highlight {
  font-size: 8.5pt;
  font-weight: 700;
  color: var(--export-primary);
}

.data-table .total-row .first-year-highlight {
  color: var(--export-primary);
}

/* Questionnaire / key-value tables */
.qa-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin: 0;
  font-size: 8pt;
  border: 0.75pt solid var(--export-border);
  border-radius: 3pt;
}

.qa-table th {
  width: 32%;
  text-align: left;
  vertical-align: top;
  padding: 4pt 6pt;
  background: var(--export-primary-light);
  color: var(--export-text);
  font-weight: 600;
  border: none;
  border-bottom: 0.5pt solid var(--export-border);
}

.qa-table td {
  padding: 4pt 6pt;
  border: none;
  border-bottom: 0.5pt solid var(--export-border);
  vertical-align: top;
  white-space: pre-wrap;
  line-height: 1.35;
  background: #fff;
}

.qa-table tbody tr:last-child th,
.qa-table tbody tr:last-child td {
  border-bottom: none;
}

.qa-table tbody tr:nth-child(even) td { background: var(--export-surface); }

.signature-line {
  border-bottom: 0.5pt solid var(--export-border-light);
  min-height: 14pt;
  margin-top: 2pt;
}

.gantt-chart {
  margin: 5pt 0 6pt;
  padding: 5pt;
  border: 0.75pt solid var(--export-border);
  border-radius: 4pt;
  background: #fff;
  page-break-inside: avoid;
}

.gantt-chart svg {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Gantt task list — wide task column for JA/EN names */
.gantt-tasks-table {
  table-layout: fixed;
  width: 100%;
}

.gantt-tasks-table th,
.gantt-tasks-table td {
  padding: 3pt 4pt;
  overflow: visible;
}

.gantt-tasks-table .col-task {
  width: 26%;
  word-break: keep-all;
  overflow-wrap: break-word;
  white-space: normal;
  line-height: 1.3;
}

.gantt-tasks-table .col-phase {
  width: 9%;
  word-break: keep-all;
  overflow-wrap: break-word;
}

.gantt-tasks-table .col-role {
  width: 10%;
  word-break: keep-all;
  overflow-wrap: break-word;
}

.gantt-tasks-table .col-hours {
  width: 7%;
}

.gantt-tasks-table .col-date {
  width: 14%;
  font-size: 7pt;
  white-space: nowrap;
}

.gantt-tasks-table .col-days {
  width: 20%;
  font-size: 7.5pt;
  white-space: nowrap;
}

.gantt-tasks-table thead .col-task,
.gantt-tasks-table thead .col-phase,
.gantt-tasks-table thead .col-role {
  white-space: normal;
  word-break: keep-all;
}

/* Questionnaire appendix */
.questionnaire-appendix {
  page-break-before: always;
  margin-top: 8pt;
}

.appendix-title {
  font-size: 10pt;
  font-weight: 600;
  color: var(--export-primary);
  margin: 0 0 6pt;
  padding-bottom: 3pt;
  border-bottom: 0.75pt solid var(--export-border);
  background: transparent;
}

.appendix-section-title {
  font-size: 9pt;
  font-weight: 600;
  color: var(--export-text);
  margin: 6pt 0 4pt;
  padding-left: 6pt;
  border-left: 2pt solid var(--export-accent);
  background: transparent;
}
