<!DOCTYPE html>
<html lang="{{ ctx.locale }}">
<head>
  <meta charset="utf-8">
  <title>{{ ctx.labels.title }}</title>
  <style>
    {% include '_export_theme.css.j2' %}
    @page { size: A4; margin: 16mm 18mm; }
    @font-face {
      font-family: "Noto Sans JP";
      src: local("Noto Sans CJK JP"), local("Noto Sans JP");
    }
    * { box-sizing: border-box; }
    body {
      font-family: "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
      font-size: 9.5pt;
      line-height: 1.45;
      color: var(--export-text-body);
      margin: 0;
      padding: 0;
    }
    h1 {
      font-size: 14pt;
      text-align: center;
      margin: 0 0 14pt;
      font-weight: 700;
      background: var(--export-blue-primary);
      color: var(--export-text-on-primary);
      padding: 10pt 16pt;
    }
    .header-grid {
      display: table;
      width: 100%;
      margin-bottom: 12pt;
    }
    .header-left, .header-right {
      display: table-cell;
      vertical-align: top;
    }
    .header-left { width: 55%; }
    .header-right { width: 45%; text-align: right; }
    .field-line { margin-bottom: 6pt; }
    .field-label { font-weight: 600; color: var(--export-blue-primary); }
    .intro { margin: 10pt 0 12pt; }
    table {
      width: 100%;
      max-width: 100%;
      border-collapse: collapse;
      margin-bottom: 12pt;
      font-size: 9pt;
      table-layout: fixed;
    }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }
    th, td {
      border: 1px solid var(--export-border);
      padding: 5pt 6pt;
      vertical-align: top;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    th {
      background: var(--export-blue-primary);
      color: var(--export-text-on-primary);
      font-weight: 600;
      text-align: left;
    }
    tbody tr:nth-child(odd):not(.total-row):not(.header-row):not(.subheader-row) td {
      background: var(--export-blue-light);
    }
    tbody tr:nth-child(even):not(.total-row):not(.header-row):not(.subheader-row) td {
      background: #fff;
    }
    .num { text-align: right; white-space: nowrap; }
    .wrap { white-space: normal; word-break: break-word; }
    .section-title {
      font-size: 10.5pt;
      font-weight: 700;
      margin: 14pt 0 6pt;
      background: var(--export-yellow-section);
      border-bottom: 2px solid var(--export-blue-primary);
      padding: 5pt 8pt;
    }
    .subsection-title {
      font-weight: 700;
      margin: 8pt 0 4pt;
      background: var(--export-yellow-section);
      border-left: 4px solid var(--export-blue-primary);
      padding: 4pt 8pt;
    }
    .note {
      font-size: 8.5pt;
      color: #444;
      margin-bottom: 8pt;
      background: var(--export-yellow-total);
      padding: 4pt 8pt;
      border-left: 3px solid var(--export-blue-primary);
    }
    .assumption { margin-bottom: 6pt; }
    .assumption-num {
      font-weight: 600;
      color: var(--export-blue-primary);
    }
    .total-row td, .total-row th {
      font-weight: 700;
      background: var(--export-yellow-total) !important;
    }
    .header-row td {
      font-weight: 700;
      background: var(--export-blue-primary) !important;
      color: var(--export-text-on-primary);
      border-bottom: none;
    }
    .subheader-row td {
      font-weight: 600;
      background: var(--export-yellow-section) !important;
      color: var(--export-text-body);
    }
    .dev-effort-table tbody tr.row-break { page-break-before: auto; }
    .questionnaire-appendix {
      page-break-before: always;
      margin-top: 16pt;
    }
    .appendix-title {
      font-size: 12pt;
      font-weight: 700;
      margin: 0 0 12pt;
      background: var(--export-blue-primary);
      color: var(--export-text-on-primary);
      padding: 6pt 10pt;
      border-bottom: none;
    }
    .appendix-section-title {
      font-size: 10pt;
      font-weight: 700;
      margin: 12pt 0 6pt;
      background: var(--export-yellow-section);
      border-left: 4px solid var(--export-blue-primary);
      padding: 4pt 8pt;
    }
    .appendix-table th {
      width: 32%;
      background: var(--export-blue-primary);
      color: var(--export-text-on-primary);
    }
    .appendix-table td {
      white-space: pre-wrap;
    }
    .appendix-table tbody tr:nth-child(odd) td {
      background: var(--export-blue-light);
    }
    .appendix-table tbody tr:nth-child(even) td {
      background: #fff;
    }
  </style>
</head>
<body>
  <h1>{{ ctx.labels.title }}</h1>

  <div class="header-grid">
    <div class="header-left">
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.issue_date }}：</span>
        {{ ctx.issue_date }}
      </div>
      {% if ctx.client_name %}
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.recipient }}：</span>
        {{ ctx.client_name }}
      </div>
      {% endif %}
      {% if ctx.intro %}
      <p class="intro">{{ ctx.intro }}</p>
      {% endif %}
    </div>
    <div class="header-right">
      {% if ctx.company.name %}
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.company_name }}：</span>
        {{ ctx.company.name }}
      </div>
      {% endif %}
      {% if ctx.show_company_address %}
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.company_address }}：</span>
        {{ ctx.company.address }}
      </div>
      {% endif %}
      {% if ctx.company.contact_person %}
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.contact_person }}：</span>
        {{ ctx.company.contact_person }}
      </div>
      {% endif %}
    </div>
  </div>

  {% if ctx.show_project_info %}
  <div class="section-title">{{ ctx.labels.project_info }}</div>
  <table>
    <tr>
      <th style="width: 28%;">{{ ctx.labels.item }}</th>
      <th>{{ ctx.labels.content }}</th>
    </tr>
    {% for row in ctx.project_rows %}
    <tr>
      <td>{{ row.label }}</td>
      <td class="{% if row.value_jpy is defined %}num{% endif %} wrap">
        {% if row.value_jpy is defined %}{{ format_currency(row.value_jpy) }}{% else %}{{ row.value }}{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if ctx.show_role_summary %}
  <div class="section-title">{{ ctx.labels.summary_title }}</div>
  <table>
    <thead>
      <tr>
        <th>{{ ctx.labels.role }}</th>
        {% if ctx.show_role_unit_rate %}<th class="num">{{ ctx.labels.unit_rate }}</th>{% endif %}
        {% if ctx.show_role_headcount %}<th class="num">{{ ctx.labels.headcount }}</th>{% endif %}
        {% if ctx.show_role_months %}<th class="num">{{ ctx.labels.months }}</th>{% endif %}
        <th class="num">{{ ctx.labels.amount }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in ctx.role_summary %}
      <tr>
        <td>{{ row.label }}</td>
        {% if ctx.show_role_unit_rate %}
        <td class="num">{% if row.unit_rate_jpy is defined %}{{ format_currency(row.unit_rate_jpy) }}{% endif %}</td>
        {% endif %}
        {% if ctx.show_role_headcount %}
        <td class="num">{% if row.headcount is defined %}{{ row.headcount }}{% endif %}</td>
        {% endif %}
        {% if ctx.show_role_months %}
        <td class="num">{% if row.months is defined %}{{ format_person_months(row.months) }}{% endif %}</td>
        {% endif %}
        <td class="num">{% if row.amount_jpy is defined %}{{ format_currency(row.amount_jpy) }}{% endif %}</td>
      </tr>
      {% endfor %}
      <tr class="total-row">
        <td colspan="{{ 1 + (1 if ctx.show_role_unit_rate else 0) + (1 if ctx.show_role_headcount else 0) + (1 if ctx.show_role_months else 0) }}">{{ ctx.labels.subtotal_ex_tax }}</td>
        <td class="num">{{ format_currency(ctx.role_subtotal_jpy) }}</td>
      </tr>
    </tbody>
  </table>
  {% endif %}

  {% if ctx.show_phase_effort or ctx.show_dev_effort %}
  <div class="section-title">{{ ctx.labels.effort_detail }}</div>
  {% endif %}

  {% if ctx.show_phase_effort %}
  <div class="subsection-title">{{ ctx.labels.phase_effort_title }}</div>
  <table>
    <thead>
      <tr>
        <th>{{ ctx.labels.phase }}</th>
        <th class="num">{{ ctx.labels.percentage }}</th>
        {% if ctx.show_phase_assignee %}<th>{{ ctx.labels.assignee }}</th>{% endif %}
        <th class="num">{{ ctx.labels.effort_days }}</th>
        <th class="num">{{ ctx.labels.effort_months }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in ctx.phase_rows %}
      <tr>
        <td>{{ row.phase }}</td>
        <td class="num">{{ row.percentage }}%</td>
        {% if ctx.show_phase_assignee %}
        <td class="wrap">{% if row.assignee %}{{ row.assignee }}{% endif %}</td>
        {% endif %}
        <td class="num">{{ format_person_days(row.effort_days) }}</td>
        <td class="num">{{ format_person_months(row.effort_months) }}</td>
      </tr>
      {% endfor %}
      <tr class="total-row">
        <td>{{ ctx.labels.total_effort }}</td>
        <td class="num">100%</td>
        {% if ctx.show_phase_assignee %}<td></td>{% endif %}
        <td class="num">{{ format_person_days(ctx.total_effort_days) }}</td>
        <td class="num">{{ format_person_months(ctx.total_effort_months) }}</td>
      </tr>
    </tbody>
  </table>
  {% endif %}

  {% if ctx.show_dev_effort %}
  <div class="subsection-title">{{ ctx.labels.dev_effort_title }}</div>
  {% if ctx.labels.dev_effort_note %}
  <p class="note">{{ ctx.labels.dev_effort_note }}</p>
  {% endif %}
  <table class="dev-effort-table">
    <thead>
      <tr>
        <th style="width: 5%;">{{ ctx.labels.no_col }}</th>
        <th style="width: 18%;">{{ ctx.labels.feature }}</th>
        <th style="width: 27%;">{{ ctx.labels.feature_summary }}</th>
        <th style="width: 18%;">{{ ctx.labels.phase_item }}</th>
        <th class="num" style="width: 12%;">{{ ctx.labels.effort_days }}</th>
      </tr>
    </thead>
    <tbody>
      {% for section in ctx.feature_sections %}
        {% if section.type == "header" %}
        <tr class="header-row">
          <td colspan="5">{{ section.label }}</td>
        </tr>
        {% elif section.type == "subheader" %}
        <tr class="subheader-row">
          <td colspan="5">{{ section.label }}</td>
        </tr>
        {% elif section.type == "row" %}
        <tr>
          <td>{% if section.no is not none %}{{ section.no }}{% endif %}</td>
          <td class="wrap">{% if section.name %}{{ section.name }}{% endif %}</td>
          <td class="wrap">{% if section.summary %}{{ section.summary }}{% endif %}</td>
          <td class="wrap">{% if section.phase_item %}{{ section.phase_item }}{% endif %}</td>
          <td class="num">{% if section.effort_days is defined %}{{ format_person_days(section.effort_days) }}{% endif %}</td>
        </tr>
        {% endif %}
      {% endfor %}
      <tr class="total-row">
        <td colspan="4">{{ ctx.labels.total_effort }}</td>
        <td class="num">{{ format_person_days(ctx.total_effort_days) }}</td>
      </tr>
    </tbody>
  </table>
  {% endif %}

  {% if ctx.show_assumptions %}
  <div class="section-title">{{ ctx.labels.assumptions_title }}</div>
  {% for assumption in ctx.assumptions %}
  <div class="assumption">
    <span class="assumption-num">{{ assumption.number }}</span>
    <span>{{ assumption.text }}</span>
  </div>
  {% endfor %}
  {% endif %}

  {% if ctx.show_approval %}
  <div class="section-title">{{ ctx.labels.approval_title }}</div>
  <table>
    <tr>
      <th style="width: 22%;">{{ ctx.labels.item }}</th>
      <th>{{ ctx.labels.content }}</th>
    </tr>
    {% if ctx.approval.company %}
    <tr>
      <td>{{ ctx.labels.approval_company }}</td>
      <td>{{ ctx.approval.company }}</td>
    </tr>
    {% endif %}
    {% if ctx.approval.approver %}
    <tr>
      <td>{{ ctx.labels.approver }}</td>
      <td>{{ ctx.approval.approver }}</td>
    </tr>
    {% endif %}
    {% if ctx.approval.approval_date %}
    <tr>
      <td>{{ ctx.labels.approval_date }}</td>
      <td>{{ ctx.approval.approval_date }}</td>
    </tr>
    {% endif %}
    {% if ctx.approval.signature %}
    <tr>
      <td>{{ ctx.labels.signature }}</td>
      <td>{{ ctx.approval.signature }}</td>
    </tr>
    {% endif %}
  </table>
  {% endif %}

  {% if ctx.show_questionnaire_appendix %}
  {% include '_questionnaire_appendix.html.j2' %}
  {% endif %}
</body>
</html>
