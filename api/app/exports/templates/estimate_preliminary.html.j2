<!DOCTYPE html>
<html lang="{{ ctx.locale }}">
<head>
  <meta charset="utf-8">
  <title>{{ ctx.labels.title }}</title>
  <style>
    @page { size: A4; margin: 16mm 18mm; }
    @font-face {
      font-family: "Noto Sans JP";
      src: local("Noto Sans CJK JP"), local("Noto Sans JP");
    }
    * { box-sizing: border-box; }
    body {
      font-family: "Noto Sans JP", "Noto Sans CJK JP", sans-serif;
      font-size: 9.5pt;
      line-height: 1.45;
      color: #111;
      margin: 0;
      padding: 0;
    }
    h1 {
      font-size: 14pt;
      text-align: center;
      margin: 0 0 14pt;
      font-weight: 700;
    }
    .header-grid {
      display: table;
      width: 100%;
      margin-bottom: 12pt;
    }
    .header-left, .header-right {
      display: table-cell;
      vertical-align: top;
    }
    .header-left { width: 55%; }
    .header-right { width: 45%; text-align: right; }
    .field-line { margin-bottom: 6pt; }
    .field-label { font-weight: 600; }
    .intro { margin: 10pt 0 12pt; }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12pt;
      font-size: 9pt;
    }
    th, td {
      border: 1px solid #333;
      padding: 5pt 6pt;
      vertical-align: top;
    }
    th {
      background: #f3f4f6;
      font-weight: 600;
      text-align: left;
    }
    .num { text-align: right; white-space: nowrap; }
    .section-title {
      font-size: 10.5pt;
      font-weight: 700;
      margin: 14pt 0 6pt;
    }
    .subsection-title {
      font-weight: 700;
      margin: 8pt 0 4pt;
    }
    .note {
      font-size: 8.5pt;
      color: #444;
      margin-bottom: 8pt;
    }
    .assumption { margin-bottom: 6pt; }
    .assumption-num { font-weight: 600; }
    .total-row td, .total-row th { font-weight: 700; background: #f9fafb; }
    .header-row td {
      font-weight: 700;
      background: #eef2f7;
      border-bottom: none;
    }
    .subheader-row td {
      font-weight: 600;
      background: #f8fafc;
    }
    .blank-cell { color: #666; }
    .questionnaire-appendix {
      page-break-before: always;
      margin-top: 16pt;
    }
    .appendix-title {
      font-size: 12pt;
      font-weight: 700;
      margin: 0 0 12pt;
      border-bottom: 1px solid #333;
      padding-bottom: 4pt;
    }
    .appendix-section-title {
      font-size: 10pt;
      font-weight: 700;
      margin: 12pt 0 6pt;
    }
    .appendix-table th {
      width: 32%;
      background: #f3f4f6;
    }
    .appendix-table td {
      white-space: pre-wrap;
    }
  </style>
</head>
<body>
  <h1>{{ ctx.labels.title }}</h1>

  <div class="header-grid">
    <div class="header-left">
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.issue_date }}：</span>
        {{ ctx.issue_date }}
      </div>
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.recipient }}：</span>
        {{ ctx.client_name }}
      </div>
      <p class="intro">{{ ctx.intro }}</p>
    </div>
    <div class="header-right">
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.company_name }}：</span>
        {{ ctx.company.name }}
      </div>
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.company_address }}：</span>
        {{ ctx.company.address or ctx.labels.blank }}
      </div>
      <div class="field-line">
        <span class="field-label">{{ ctx.labels.contact_person }}：</span>
        <span class="blank-cell">{{ ctx.company.contact_person }}</span>
      </div>
    </div>
  </div>

  <div class="section-title">{{ ctx.labels.project_info }}</div>
  <table>
    <tr>
      <th style="width: 28%;">{{ ctx.labels.item }}</th>
      <th>{{ ctx.labels.content }}</th>
    </tr>
    <tr>
      <td>{{ ctx.labels.project_name }}</td>
      <td>{{ ctx.project_name }}</td>
    </tr>
    <tr>
      <td>{{ ctx.labels.total_with_tax }}</td>
      <td class="num">{{ format_currency(ctx.grand_total_jpy) }}</td>
    </tr>
  </table>

  <div class="section-title">{{ ctx.labels.summary_title }}</div>
  <table>
    <thead>
      <tr>
        <th>{{ ctx.labels.role }}</th>
        <th class="num">{{ ctx.labels.unit_rate }}</th>
        <th class="num">{{ ctx.labels.utilization }}</th>
        <th class="num">{{ ctx.labels.headcount }}</th>
        <th class="num">{{ ctx.labels.months }}</th>
        <th class="num">{{ ctx.labels.amount }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in ctx.role_summary %}
      <tr>
        <td>{{ row.label }}</td>
        <td class="num">{% if row.unit_rate_jpy is not none %}{{ format_currency(row.unit_rate_jpy) }}{% else %}{{ ctx.labels.dash }}{% endif %}</td>
        <td class="num">{{ row.utilization }}</td>
        <td class="num">{% if row.headcount is not none %}{{ row.headcount }}{% else %}{{ ctx.labels.dash }}{% endif %}</td>
        <td class="num">{% if row.months is not none %}{{ "%.2f"|format(row.months) }}{% else %}{{ ctx.labels.dash }}{% endif %}</td>
        <td class="num">{% if row.amount_jpy is not none %}{{ format_currency(row.amount_jpy) }}{% else %}{{ ctx.labels.dash }}{% endif %}</td>
      </tr>
      {% endfor %}
      <tr class="total-row">
        <td colspan="5">{{ ctx.labels.subtotal_ex_tax }}</td>
        <td class="num">{{ format_currency(ctx.role_subtotal_jpy) }}</td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">{{ ctx.labels.effort_detail }}</div>
  <div class="subsection-title">{{ ctx.labels.phase_effort_title }}</div>
  <table>
    <thead>
      <tr>
        <th>{{ ctx.labels.phase }}</th>
        <th class="num">{{ ctx.labels.percentage }}</th>
        <th>{{ ctx.labels.assignee }}</th>
        <th class="num">{{ ctx.labels.effort_days }}</th>
        <th class="num">{{ ctx.labels.effort_months }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in ctx.phase_rows %}
      <tr>
        <td>{{ row.phase }}</td>
        <td class="num">{% if row.effort_days is not none %}{{ row.percentage }}%{% else %}{{ ctx.labels.dash }}{% endif %}</td>
        <td>{{ row.assignee }}</td>
        <td class="num">{% if row.effort_days is not none %}{{ format_effort_days(row.effort_days) }}{% else %}{{ ctx.labels.dash }}{% endif %}</td>
        <td class="num">{% if row.effort_months is not none %}{{ "%.2f"|format(row.effort_months) }}{% else %}{{ ctx.labels.dash }}{% endif %}</td>
      </tr>
      {% endfor %}
      <tr class="total-row">
        <td>{{ ctx.labels.total_effort }}</td>
        <td class="num">100%</td>
        <td></td>
        <td class="num">{{ format_effort_days(ctx.total_effort_days) }}</td>
        <td class="num">{{ "%.2f"|format(ctx.total_effort_months) }}</td>
      </tr>
    </tbody>
  </table>

  <div class="subsection-title">{{ ctx.labels.dev_effort_title }}</div>
  <p class="note">{{ ctx.labels.dev_effort_note }}</p>
  <table>
    <thead>
      <tr>
        <th style="width: 5%;">{{ ctx.labels.no_col }}</th>
        <th style="width: 18%;">{{ ctx.labels.feature }}</th>
        <th style="width: 24%;">{{ ctx.labels.feature_summary }}</th>
        <th style="width: 18%;">{{ ctx.labels.phase_item }}</th>
        <th class="num" style="width: 12%;">{{ ctx.labels.effort_days }}</th>
        <th style="width: 23%;">{{ ctx.labels.remarks }}</th>
      </tr>
    </thead>
    <tbody>
      {% for section in ctx.feature_sections %}
        {% if section.type == "header" %}
        <tr class="header-row">
          <td colspan="6">{{ section.label }}</td>
        </tr>
        {% elif section.type == "subheader" %}
        <tr class="subheader-row">
          <td colspan="6">{{ section.label }}</td>
        </tr>
        {% elif section.type == "row" %}
        <tr>
          <td>{% if section.no is not none %}{{ section.no }}{% endif %}</td>
          <td>{{ section.name }}</td>
          <td>{{ section.summary }}</td>
          <td>{{ section.phase_item }}</td>
          <td class="num">{% if section.effort_days is not none %}{{ format_effort_days(section.effort_days) }}{% else %}{{ ctx.labels.dash }}{% endif %}</td>
          <td>{{ section.remarks }}</td>
        </tr>
        {% endif %}
      {% endfor %}
      <tr class="total-row">
        <td colspan="4">{{ ctx.labels.total_effort }}</td>
        <td class="num">{{ format_effort_days(ctx.total_effort_days) }}</td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">{{ ctx.labels.assumptions_title }}</div>
  {% for assumption in ctx.assumptions %}
  <div class="assumption">
    <span class="assumption-num">{{ assumption.number }}</span>
    <span>{{ assumption.text }}</span>
  </div>
  {% endfor %}

  <div class="section-title">{{ ctx.labels.approval_title }}</div>
  <table>
    <tr>
      <th style="width: 22%;">{{ ctx.labels.item }}</th>
      <th>{{ ctx.labels.content }}</th>
    </tr>
    <tr>
      <td>{{ ctx.labels.approval_company }}</td>
      <td class="blank-cell">{{ ctx.approval.company }}</td>
    </tr>
    <tr>
      <td>{{ ctx.labels.approver }}</td>
      <td class="blank-cell">{{ ctx.approval.approver }}</td>
    </tr>
    <tr>
      <td>{{ ctx.labels.approval_date }}</td>
      <td class="blank-cell">{{ ctx.approval.approval_date }}</td>
    </tr>
    <tr>
      <td>{{ ctx.labels.signature }}</td>
      <td class="blank-cell">{{ ctx.approval.signature }}</td>
    </tr>
  </table>

  {% include '_questionnaire_appendix.html.j2' %}
</body>
</html>
