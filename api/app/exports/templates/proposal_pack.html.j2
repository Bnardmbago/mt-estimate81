<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8" />
  <title>{{ ctx.project_name }} — {{ ctx.labels.title }}</title>
  {% set cover_page_size = ctx.page.size if ctx.page and ctx.page.size else 'A4' %}
  {% if cover_page_size == 'A3' %}
    {% set cover_page_width_mm = 297 %}
    {% set cover_page_height_mm = 420 %}
  {% elif cover_page_size == 'Letter' %}
    {% set cover_page_width_mm = 215.9 %}
    {% set cover_page_height_mm = 279.4 %}
  {% elif cover_page_size == 'Legal' %}
    {% set cover_page_width_mm = 215.9 %}
    {% set cover_page_height_mm = 355.6 %}
  {% else %}
    {% set cover_page_width_mm = 210 %}
    {% set cover_page_height_mm = 297 %}
  {% endif %}
  {% if ctx.page and ctx.page.orientation == 'landscape' %}
    {% set portrait_page_width_mm = cover_page_width_mm %}
    {% set cover_page_width_mm = cover_page_height_mm %}
    {% set cover_page_height_mm = portrait_page_width_mm %}
  {% endif %}
  <style>
    @page {
      size: {{ (ctx.page.css_size if ctx.page and ctx.page.css_size else 'A4 portrait') }};
      margin: {{ (ctx.style.margins.top_mm if ctx.style and ctx.style.margins else 18) }}mm
             {{ (ctx.style.margins.right_mm if ctx.style and ctx.style.margins else 16) }}mm
             {{ (ctx.style.margins.bottom_mm if ctx.style and ctx.style.margins else 18) }}mm
             {{ (ctx.style.margins.left_mm if ctx.style and ctx.style.margins else 16) }}mm;
      @top-left {
        content: string(doc-title);
        font-size: {{ (ctx.style.header_footer_font_size_pt if ctx.style else 8) }}pt;
        color: #{{ ctx.theme.text_muted }};
        font-family: "Noto Sans JP", "Helvetica Neue", Arial, sans-serif;
      }
      @top-right {
        content: string(part-title);
        font-size: {{ (ctx.style.header_footer_font_size_pt if ctx.style else 8) }}pt;
        color: #{{ ctx.theme.text_muted }};
        font-family: "Noto Sans JP", "Helvetica Neue", Arial, sans-serif;
      }
      @bottom-center {
        content: "{{ ctx.labels.title }} · " counter(page);
        font-size: {{ (ctx.style.header_footer_font_size_pt if ctx.style else 8) }}pt;
        color: #{{ ctx.theme.text_muted }};
        font-family: "Noto Sans JP", "Helvetica Neue", Arial, sans-serif;
      }
    }
    /* Full-bleed cover page — geometry % match Admin Cover canvas (full page). */
    @page cover {
      size: {{ (ctx.page.css_size if ctx.page and ctx.page.css_size else 'A4 portrait') }};
      margin: 0;
      @top-left { content: none; }
      @top-right { content: none; }
      @bottom-center { content: none; }
    }
    @page :first {
      @top-left { content: none; }
      @top-right { content: none; }
    }

    :root {
      --primary: #{{ ctx.theme.primary }};
      --primary-light: #{{ ctx.theme.primary_light }};
      --accent: #{{ ctx.theme.accent }};
      --callout: #{{ ctx.theme.callout if ctx.theme.callout is defined else ctx.theme.accent }};
      --table-highlight: #{{ ctx.theme.table_highlight if ctx.theme.table_highlight is defined else ctx.theme.accent }};
      --surface: #{{ ctx.theme.surface }};
      --border: #{{ ctx.theme.border }};
      --text-body: #{{ ctx.theme.text_body }};
      --text-muted: #{{ ctx.theme.text_muted }};
      --on-primary: #{{ ctx.theme.text_on_primary }};
      --cover-page-width: {{ cover_page_width_mm }}mm;
      --cover-page-height: {{ cover_page_height_mm }}mm;
    }

    * { box-sizing: border-box; }

    body {
      font-family: "Noto Sans JP", "Helvetica Neue", Arial, sans-serif;
      font-size: {{ (ctx.style.base_font_size_pt if ctx.style else 10) }}pt;
      font-weight: 400;
      line-height: {{ (ctx.style.line_spacing if ctx.style else 1.15) }};
      color: var(--text-body);
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body.layout-executive-cover .cover-extra {
      display: block;
    }
    body.layout-two-column .summary-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12pt;
    }
    body.chrome-cards .section-block {
      border: 1pt solid var(--border);
      border-radius: 4pt;
      padding: 10pt 12pt;
      margin-bottom: 10pt;
      background: var(--surface);
    }
    body.chrome-minimal h3.section {
      border-bottom: none;
    }
    body.chrome-ruled h3.section {
      border-bottom: 1pt solid var(--accent);
      padding-bottom: 4pt;
    }

    /* Document title — 24pt bold */
    .doc-title {
      string-set: doc-title content();
      font-size: 24pt;
      font-weight: 700;
      line-height: 1.2;
      color: var(--on-primary);
      margin: 0 0 6pt;
    }

    .cover {
      page: cover;
      background: {{ ctx.cover.background_color if ctx.cover and ctx.cover.background_color else '#FFFFFF' }};
      color: {{ ctx.cover.text_color if ctx.cover and ctx.cover.text_color else '#334155' }};
      margin: 0;
      border-radius: 0;
      width: var(--cover-page-width);
      height: var(--cover-page-height);
      position: relative;
      overflow: hidden;
      page-break-after: always;
      text-align: {{ (ctx.cover.design.alignment if ctx.cover and ctx.cover.design and ctx.cover.design.alignment else 'left') }};
    }
    .cover .meta {
      font-size: 11pt;
      color: {{ ctx.cover.text_color if ctx.cover and ctx.cover.text_color else '#334155' }};
      opacity: 0.85;
      margin: 0;
    }
    .cover .doc-title {
      color: {{ ctx.cover.title_color if ctx.cover and ctx.cover.title_color else '#1E3A5F' }};
      font-size: {{ (ctx.cover.design.typography.title_pt if ctx.cover and ctx.cover.design and ctx.cover.design.typography else 30) }}pt;
      font-weight: 700;
      margin: 0;
    }
    /* Padding only for auto-stacked fields — absolute geometry is page-relative.
       Vertically centered to match the Admin Cover canvas auto-layout. */
    .cover-content {
      position: relative;
      z-index: 3;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: {{ (ctx.cover.design.padding_mm if ctx.cover and ctx.cover.design and ctx.cover.design.padding_mm else 24) }}mm;
    }
    .cover-content .cover-field + .cover-field { margin-top: 8pt; }
    .cover-accent-art {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
    }
    /* Keep SVG intrinsic mm size — WeasyPrint drops fills when forced to 100%. */
    .cover-accent-art svg { display: block; max-width: none; max-height: none; }
    .cover-field { position: relative; z-index: 3; margin: 0; }
    .cover-field-label { display: block; font-size: 8pt; opacity: 0.8; }
    .cover-field-value {
      display: block;
      font-size: {{ (ctx.cover.design.typography.metadata_pt if ctx.cover and ctx.cover.design and ctx.cover.design.typography and ctx.cover.design.typography.metadata_pt else 10) }}pt;
    }
    .cover-field-title .cover-field-value {
      display: block;
      font-size: {{ (ctx.cover.design.typography.title_pt if ctx.cover and ctx.cover.design and ctx.cover.design.typography else 30) }}pt;
      font-weight: 700;
      line-height: 1.15;
      color: {{ ctx.cover.title_color if ctx.cover and ctx.cover.title_color else '#1E3A5F' }};
    }
    .cover-field-styled .cover-field-value {
      font-family: inherit;
      font-size: inherit;
      font-weight: inherit;
      font-style: inherit;
      color: inherit;
      text-align: inherit;
      line-height: inherit;
      letter-spacing: inherit;
    }
    .cover-asset { position: absolute; z-index: 2; object-fit: contain; }
    .cover-asset-background {
      /* Position/size come from asset.background_css (focal-point pan/zoom). */
      z-index: 0;
      pointer-events: none;
    }
    .cover-asset-logo { top: 18mm; right: 18mm; max-width: 48mm; max-height: 24mm; }
    .cover-asset-decorative { right: 0; bottom: 0; max-width: 45%; max-height: 45%; }

    /* Chapter headers — 18pt bold */
    h2.chapter {
      string-set: part-title content();
      font-size: 18pt;
      font-weight: 700;
      line-height: 1.25;
      color: var(--primary);
      border-bottom: 2.5pt solid var(--accent);
      padding-bottom: 6pt;
      margin: 28pt 0 14pt;
      page-break-before: always;
      page-break-after: avoid;
    }
    h2.chapter.first {
      page-break-before: avoid;
      margin-top: 8pt;
    }

    /* Section headers — 14pt bold */
    h3.section {
      font-size: 14pt;
      font-weight: 700;
      line-height: 1.3;
      color: var(--primary);
      margin: 16pt 0 8pt;
      page-break-after: avoid;
    }

    /* Subsection headers — 12pt semi-bold */
    h4.subsection {
      font-size: 12pt;
      font-weight: 600;
      line-height: 1.3;
      color: var(--primary);
      margin: 12pt 0 6pt;
      page-break-after: avoid;
    }

    p {
      font-size: 10pt;
      font-weight: 400;
      line-height: 1.15;
      margin: 0 0 8pt;
      text-align: justify;
    }

    ul, ol {
      margin: 0 0 10pt;
      padding-left: 18pt;
    }
    li {
      font-size: 10pt;
      line-height: 1.15;
      margin: 0 0 4pt;
      text-align: justify;
    }

    .toc {
      background: var(--primary-light);
      border: 1pt solid var(--border);
      border-left: 4pt solid var(--accent);
      padding: 14pt 16pt;
      margin: 0 0 18pt;
      page-break-after: always;
    }
    .toc-title {
      font-size: 14pt;
      font-weight: 700;
      color: var(--primary);
      margin: 0 0 10pt;
    }
    .toc ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .toc li {
      margin: 0 0 5pt;
      text-align: left;
    }
    .toc a {
      color: var(--text-body);
      text-decoration: none;
    }
    .toc a::after {
      content: leader('.') target-counter(attr(href), page);
      color: var(--text-muted);
      font-size: 9pt;
    }
    .toc .level-1 {
      font-weight: 700;
      font-size: 11pt;
      margin-top: 8pt;
    }
    .toc .level-2 {
      font-weight: 400;
      font-size: 10pt;
      padding-left: 14pt;
    }

    .rating {
      display: inline-block;
      background: var(--accent);
      color: var(--on-primary);
      padding: 2pt 8pt;
      border-radius: 3pt;
      font-size: 9pt;
      font-weight: 600;
      margin: 0 0 6pt;
    }

    .cost-box, .poc-box, .brief-box {
      border: 1pt solid var(--border);
      border-left: 4pt solid var(--callout);
      padding: 12pt 14pt;
      margin: 0 0 14pt;
      background: var(--surface);
      page-break-inside: avoid;
    }
    .brief-box {
      background: var(--primary-light);
    }
    .brief-box dl { margin: 0; }
    .brief-box dt {
      font-size: 10pt;
      font-weight: 600;
      color: var(--primary);
      margin-top: 8pt;
    }
    .brief-box dd {
      margin: 2pt 0 0;
      font-size: 10pt;
      text-align: justify;
    }

    .section-card {
      border: 1pt solid var(--border);
      border-radius: 3pt;
      padding: 10pt 12pt;
      margin: 0 0 12pt;
      background: #ffffff;
      page-break-inside: avoid;
    }

    table.data {
      width: 100%;
      border-collapse: collapse;
      margin: 8pt 0 14pt;
      font-size: 9.5pt;
      page-break-inside: avoid;
    }
    table.data caption {
      caption-side: top;
      text-align: left;
      font-size: 12pt;
      font-weight: 600;
      color: var(--primary);
      margin-bottom: 6pt;
    }
    table.data th {
      background: var(--primary);
      color: var(--on-primary);
      text-align: left;
      padding: 6pt 8pt;
      font-weight: 600;
      border-bottom: 2pt solid var(--table-highlight);
    }
    table.data td {
      border: 1pt solid var(--border);
      padding: 6pt 8pt;
      vertical-align: top;
      text-align: left;
    }

    .gantt svg, .diagram-block {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 8pt 0 14pt;
    }
    img.diagram-block {
      /* Tall TD flowcharts must not stretch to full page width (creates huge gaps). */
      max-width: 55%;
      max-height: 280pt;
      width: auto;
      height: auto;
      margin: 6pt auto 10pt;
      object-fit: contain;
    }
    pre.diagram {
      background: var(--surface);
      border: 1pt solid var(--border);
      padding: 10pt;
      white-space: pre-wrap;
      font-size: 8.5pt;
      line-height: 1.25;
      margin: 0 0 14pt;
    }
    .muted { color: var(--text-muted); font-size: 9pt; }
  </style>
</head>
<body class="layout-{{ (ctx.layout.layout if ctx.layout else 'linear') | replace('_', '-') }} chrome-{{ ctx.layout.section_chrome if ctx.layout else 'ruled' }}">
  {% if ctx.include_cover %}
  <div class="cover">
    {% for asset in ctx.cover.assets or [] %}
      {% if asset.url and (asset.region or 'decorative') == 'background' %}
      <img
        class="cover-asset cover-asset-{{ asset.region or 'decorative' }}"
        src="{{ asset.url }}"
        alt="{{ asset.alt or asset.region or '' }}"
        style="{{ asset.background_css or cover_background_inline_css(asset) }}"
      />
      {% endif %}
    {% endfor %}
    {% include '_cover_accent_svg.html.j2' %}
    {% for asset in ctx.cover.assets or [] %}
      {% if asset.url and (asset.region or 'decorative') != 'background' %}
      {% set asset_geometry = asset.geometry or {} %}
      <img
        class="cover-asset cover-asset-{{ asset.region or 'decorative' }}"
        src="{{ asset.url }}"
        alt="{{ asset.alt or asset.region or '' }}"
        style="opacity:{{ asset.opacity if asset.opacity is defined else 1 }};{% if asset_geometry.x_pct is defined %}left:{{ asset_geometry.x_pct }}%;right:auto;{% elif asset.x_pct is defined %}left:{{ asset.x_pct }}%;right:auto;{% elif asset.x is defined %}left:{{ asset.x }}%;right:auto;{% endif %}{% if asset_geometry.y_pct is defined %}top:{{ asset_geometry.y_pct }}%;bottom:auto;{% elif asset.y_pct is defined %}top:{{ asset.y_pct }}%;bottom:auto;{% elif asset.y is defined %}top:{{ asset.y }}%;bottom:auto;{% endif %}{% if asset_geometry.width_pct is defined %}width:{{ asset_geometry.width_pct }}%;max-width:none;{% elif asset.width_pct is defined %}width:{{ asset.width_pct }}%;max-width:none;{% endif %}{% if asset_geometry.height_pct is defined %}height:{{ asset_geometry.height_pct }}%;max-height:none;{% elif asset.height_pct is defined %}height:{{ asset.height_pct }}%;max-height:none;{% endif %}{% if asset_geometry.z_index is defined %}z-index:{{ asset_geometry.z_index }};{% elif asset.z_index is defined %}z-index:{{ asset.z_index }};{% endif %}{% set asset_rotation = asset_geometry.rotation_deg if asset_geometry.rotation_deg is defined else asset.rotation %}{% if asset_rotation %}transform:rotate({{ asset_rotation }}deg);transform-origin:center;{% endif %}"
      />
      {% endif %}
    {% endfor %}
    <div class="cover-content">
      {% if ctx.cover.fields %}
        {% for field in ctx.cover.fields %}
          {% if field.value is not none and not field.geometry %}
          {% set field_style = field.style or {} %}
          <div class="cover-field cover-field-{{ field.emphasis or 'metadata' }}{% if field_style %} cover-field-styled{% endif %}" data-cover-key="{{ field.key }}"{% if field_style %} style="{% if field_style.font_family is defined %}font-family:{{ field_style.font_family | tojson | forceescape }};{% endif %}{% if field_style.font_size_pt is defined %}font-size:{{ field_style.font_size_pt }}pt;{% endif %}{% if field_style.font_weight is defined %}font-weight:{{ field_style.font_weight }};{% endif %}{% if field_style.italic is defined %}font-style:{{ 'italic' if field_style.italic else 'normal' }};{% endif %}{% if field_style.color is defined %}color:{{ field_style.color }};{% endif %}{% if field_style.alignment is defined %}text-align:{{ field_style.alignment }};{% elif field_style.text_align is defined %}text-align:{{ field_style.text_align }};{% endif %}{% if field_style.line_height is defined %}line-height:{{ field_style.line_height }};{% endif %}{% if field_style.letter_spacing_pt is defined %}letter-spacing:{{ field_style.letter_spacing_pt }}pt;{% elif field_style.letter_spacing_em is defined %}letter-spacing:{{ field_style.letter_spacing_em }}em;{% endif %}{% if field_style.opacity is defined %}opacity:{{ field_style.opacity }};{% endif %}{% if field_style.background_color is defined %}background-color:{{ field_style.background_color }};{% endif %}{% if field_style.padding_mm is defined %}padding:{{ field_style.padding_mm }}mm;{% endif %}"{% endif %}>
            {% if field.emphasis != 'title' %}<span class="cover-field-label">{{ field.label }}</span>{% endif %}
            <span class="cover-field-value">{{ field.value }}</span>
          </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <h1 class="doc-title">{{ ctx.project_name }}</h1>
      {% endif %}
    </div>
    {% for field in ctx.cover.fields or [] %}
      {% if field.value is not none and field.geometry %}
      {% set geometry = field.geometry %}
      {% set field_style = field.style or {} %}
      <div class="cover-field cover-field-{{ field.emphasis or 'metadata' }}{% if field_style %} cover-field-styled{% endif %}" data-cover-key="{{ field.key }}" style="position:absolute;left:{{ geometry.x_pct }}%;top:{{ geometry.y_pct }}%;width:{{ geometry.width_pct }}%;{% if geometry.height_pct is defined %}height:{{ geometry.height_pct }}%;{% endif %}z-index:{{ geometry.z_index }};{% if geometry.rotation_deg is defined and geometry.rotation_deg %}transform:rotate({{ geometry.rotation_deg }}deg);transform-origin:center;{% endif %}{% if field_style.font_family is defined %}font-family:{{ field_style.font_family | tojson | forceescape }};{% endif %}{% if field_style.font_size_pt is defined %}font-size:{{ field_style.font_size_pt }}pt;{% endif %}{% if field_style.font_weight is defined %}font-weight:{{ field_style.font_weight }};{% endif %}{% if field_style.italic is defined %}font-style:{{ 'italic' if field_style.italic else 'normal' }};{% endif %}{% if field_style.color is defined %}color:{{ field_style.color }};{% endif %}{% if field_style.alignment is defined %}text-align:{{ field_style.alignment }};{% elif field_style.text_align is defined %}text-align:{{ field_style.text_align }};{% endif %}{% if field_style.line_height is defined %}line-height:{{ field_style.line_height }};{% endif %}{% if field_style.letter_spacing_pt is defined %}letter-spacing:{{ field_style.letter_spacing_pt }}pt;{% elif field_style.letter_spacing_em is defined %}letter-spacing:{{ field_style.letter_spacing_em }}em;{% endif %}{% if field_style.opacity is defined %}opacity:{{ field_style.opacity }};{% endif %}{% if field_style.background_color is defined %}background-color:{{ field_style.background_color }};{% endif %}{% if field_style.padding_mm is defined %}padding:{{ field_style.padding_mm }}mm;{% endif %}">
        {% if field.emphasis != 'title' %}<span class="cover-field-label">{{ field.label }}</span>{% endif %}
        <span class="cover-field-value">{{ field.value }}</span>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <nav class="toc" id="toc">
    <div class="toc-title">{{ ctx.labels.toc }}</div>
    <ol>
      {% for item in ctx.toc %}
        <li class="level-{{ item.level }}">
          <a href="#{{ item.id }}">{{ item.title }}</a>
        </li>
      {% endfor %}
    </ol>
  </nav>

  {% if ctx.cost_summary and ctx.variant in ['full', 'proposal'] %}
  <div class="cost-box summary-grid">
    <div><strong>{{ ctx.labels.one_time }}:</strong> {{ ctx.cost_summary.one_time_project_cost_jpy }} JPY</div>
    <div><strong>{{ ctx.labels.monthly }}:</strong> {{ ctx.cost_summary.monthly_recurring_cost_jpy }} JPY</div>
    <div><strong>{{ ctx.labels.first_year }}:</strong> {{ ctx.cost_summary.first_year_total_jpy }} JPY</div>
  </div>
  {% endif %}

  {% macro render_part(part_id, title, blob, first=false) %}
    {% if blob %}
      <h2 class="chapter{{ ' first' if first else '' }}" id="{{ part_id }}">{{ title }}</h2>

      {% if part_id == 'poc' and blob.project_brief %}
        <div class="brief-box" id="poc-project_brief">
          <h3 class="section">{{ ctx.labels.project_brief }}</h3>
          <dl>
            <dt>{{ ctx.labels.brief_project_name }}</dt>
            <dd>{{ blob.project_brief.project_name }}</dd>
            <dt>{{ ctx.labels.brief_description }}</dt>
            <dd>{{ blob.project_brief.project_description }}</dd>
            <dt>{{ ctx.labels.brief_business_problem }}</dt>
            <dd>{{ blob.project_brief.business_problem }}</dd>
            <dt>{{ ctx.labels.brief_target_users }}</dt>
            <dd>{{ blob.project_brief.target_users }}</dd>
            <dt>{{ ctx.labels.brief_technology_stack }}</dt>
            <dd>{{ blob.project_brief.technology_stack }}</dd>
            <dt>{{ ctx.labels.brief_constraints }}</dt>
            <dd>{{ blob.project_brief.constraints }}</dd>
          </dl>
        </div>
      {% endif %}

      {% for section in blob.sections or [] %}
        <div class="section-card" id="{{ part_id }}-{{ section.id }}">
          <h3 class="section">{{ section.title }}</h3>
          {% if part_id == 'assessment' and section.rating %}
            {% set r = (section.rating or '')|lower %}
            <div class="rating">
              {% if locale == 'ja' %}
                {% if r == 'high' %}高{% elif r == 'medium' %}中{% elif r == 'low' %}低{% else %}{{ section.rating }}{% endif %}
              {% else %}
                {{ section.rating }}
              {% endif %}
            </div>
          {% endif %}
          {% if section.body %}<p>{{ section.body }}</p>{% endif %}
          {% if section.bullets %}
            <ul>
              {% for bullet in section.bullets %}
                <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}

      {% if part_id == 'poc' %}
        {% if blob.tables %}
          <h4 class="subsection">{{ ctx.labels.poc_tables }}</h4>
          {% for table in blob.tables %}
            <table class="data">
              <caption>{{ table.title }}</caption>
              <thead>
                <tr>
                  {% for h in table.headers or [] %}<th>{{ h }}</th>{% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in table.rows or [] %}
                  <tr>
                    {% for cell in row %}<td>{{ cell }}</td>{% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% endfor %}
        {% endif %}
        {% if blob.diagrams %}
          <h4 class="subsection">{{ ctx.labels.poc_diagrams }}</h4>
          {% for diagram in blob.diagrams %}
            <h4 class="subsection">{{ diagram.title }}</h4>
            {% if diagram.png_base64 %}
              <img class="diagram-block" alt="{{ diagram.title }}" src="data:image/png;base64,{{ diagram.png_base64 }}"/>
            {% elif diagram.svg %}
              <div class="diagram-block">{{ diagram.svg | safe }}</div>
            {% else %}
              <pre class="diagram">{{ diagram.source }}</pre>
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if blob.milestones %}
          <h4 class="subsection">{{ ctx.labels.poc_milestones }}</h4>
          <ul>
            {% for m in blob.milestones %}
              <li>{{ m.name }}{% if m.date %} — {{ m.date }}{% endif %}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endif %}
    {% endif %}
  {% endmacro %}

  {{ render_part('assessment', ctx.labels.assessment, ctx.assessment, true) }}
  {{ render_part('proposal', ctx.labels.proposal, ctx.proposal_body, not ctx.assessment) }}

  {% if ctx.proposal_body and ctx.gantt_svg %}
    <h4 class="subsection">{{ ctx.labels.timeline }}</h4>
    <div class="gantt diagram-block">{{ ctx.gantt_svg | safe }}</div>
  {% endif %}

  {% if ctx.milestones %}
    <h4 class="subsection">{{ ctx.labels.milestones }}</h4>
    <ul>
      {% for m in ctx.milestones %}
        <li>{{ m.name }}{% if m.date %} — {{ m.date }}{% endif %}</li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if ctx.diagrams %}
    {% for diagram in ctx.diagrams %}
      <h4 class="subsection">{{ diagram.title }}</h4>
      {% if diagram.png_base64 %}
        <img class="diagram-block" alt="{{ diagram.title }}" src="data:image/png;base64,{{ diagram.png_base64 }}"/>
      {% elif diagram.svg %}
        <div class="diagram-block">{{ diagram.svg | safe }}</div>
      {% else %}
        <pre class="diagram">{{ diagram.source }}</pre>
      {% endif %}
    {% endfor %}
  {% endif %}

  {{ render_part('poc', ctx.labels.poc, ctx.poc) }}

  {% if ctx.poc and ctx.poc.official %}
    <div class="poc-box">
      <h4 class="subsection" style="margin-top:0">{{ ctx.labels.official_poc_cost }}</h4>
      <div>{{ ctx.labels.effort_hours }}: {{ ctx.poc.official.total_effort_hours }}</div>
      <div>{{ ctx.labels.effort_days }}: {{ ctx.poc.official.total_effort_days }}</div>
      <div>{{ ctx.labels.working_days }}: {{ ctx.poc.official.estimated_timeline_working_days }}</div>
      <div>{{ ctx.labels.one_time }}: {{ ctx.poc.official.estimated_one_time_cost_jpy }} JPY</div>
      {% if ctx.poc.suggested_validation_window %}
        <p class="muted">{{ ctx.labels.suggested_window }}: {{ ctx.poc.suggested_validation_window }}</p>
      {% endif %}
    </div>
  {% endif %}
</body>
</html>
