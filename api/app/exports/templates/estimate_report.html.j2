<!DOCTYPE html>
<html lang="{{ ctx.locale }}">
<head>
  <meta charset="utf-8">
  <title>{{ ctx.labels.title }}</title>
  <style>
    {% include '_export_theme.css.j2' %}
    {% include '_pdf_base.css.j2' %}
    {% if show_watermark %}
    {% include '_watermark.css.j2' %}
    {% endif %}
  </style>
</head>
<body>
  {% if show_watermark %}
  <div class="contact-watermark">{{ watermark_text }}</div>
  {% endif %}
  {% if ctx.include_cover %}
  <section class="estimate-cover">
    {% for asset in ctx.cover.assets or [] %}
      {% if asset.url and (asset.region or 'decorative') == 'background' %}
      <img
        class="estimate-cover-asset estimate-cover-asset-{{ asset.region or 'decorative' }}"
        src="{{ asset.url }}"
        alt="{{ asset.alt or asset.region or '' }}"
        style="{{ asset.background_css or cover_background_inline_css(asset) }}"
      />
      {% endif %}
    {% endfor %}
    {% include '_cover_accent_svg.html.j2' %}
    {% for asset in ctx.cover.assets or [] %}
      {% if asset.url and (asset.region or 'decorative') != 'background' %}
      {% set asset_geometry = asset.geometry or {} %}
      <img
        class="estimate-cover-asset estimate-cover-asset-{{ asset.region or 'decorative' }}"
        src="{{ asset.url }}"
        alt="{{ asset.alt or asset.region or '' }}"
        style="opacity:{{ asset.opacity if asset.opacity is defined else 1 }};{% if asset_geometry.x_pct is defined %}left:{{ asset_geometry.x_pct }}%;right:auto;{% elif asset.x_pct is defined %}left:{{ asset.x_pct }}%;right:auto;{% elif asset.x is defined %}left:{{ asset.x }}%;right:auto;{% endif %}{% if asset_geometry.y_pct is defined %}top:{{ asset_geometry.y_pct }}%;bottom:auto;{% elif asset.y_pct is defined %}top:{{ asset.y_pct }}%;bottom:auto;{% elif asset.y is defined %}top:{{ asset.y }}%;bottom:auto;{% endif %}{% if asset_geometry.width_pct is defined %}width:{{ asset_geometry.width_pct }}%;max-width:none;{% elif asset.width_pct is defined %}width:{{ asset.width_pct }}%;max-width:none;{% endif %}{% if asset_geometry.height_pct is defined %}height:{{ asset_geometry.height_pct }}%;max-height:none;{% elif asset.height_pct is defined %}height:{{ asset.height_pct }}%;max-height:none;{% endif %}{% if asset_geometry.z_index is defined %}z-index:{{ asset_geometry.z_index }};{% elif asset.z_index is defined %}z-index:{{ asset.z_index }};{% endif %}{% set asset_rotation = asset_geometry.rotation_deg if asset_geometry.rotation_deg is defined else asset.rotation %}{% if asset_rotation %}transform:rotate({{ asset_rotation }}deg);transform-origin:center;{% endif %}"
      />
      {% endif %}
    {% endfor %}
    <div class="estimate-cover-content">
      {% if ctx.cover.fields %}
        {% for field in ctx.cover.fields %}
          {% if field.value is not none and not field.geometry %}
          {% set field_style = field.style or {} %}
          <div class="estimate-cover-field estimate-cover-field-{{ field.emphasis or 'metadata' }}{% if field_style %} estimate-cover-field-styled{% endif %}" data-cover-key="{{ field.key }}"{% if field_style %} style="{% if field_style.font_family is defined %}font-family:{{ field_style.font_family | tojson | forceescape }};{% endif %}{% if field_style.font_size_pt is defined %}font-size:{{ field_style.font_size_pt }}pt;{% endif %}{% if field_style.font_weight is defined %}font-weight:{{ field_style.font_weight }};{% endif %}{% if field_style.italic is defined %}font-style:{{ 'italic' if field_style.italic else 'normal' }};{% endif %}{% if field_style.color is defined %}color:{{ field_style.color }};{% endif %}{% if field_style.alignment is defined %}text-align:{{ field_style.alignment }};{% elif field_style.text_align is defined %}text-align:{{ field_style.text_align }};{% endif %}{% if field_style.line_height is defined %}line-height:{{ field_style.line_height }};{% endif %}{% if field_style.letter_spacing_pt is defined %}letter-spacing:{{ field_style.letter_spacing_pt }}pt;{% elif field_style.letter_spacing_em is defined %}letter-spacing:{{ field_style.letter_spacing_em }}em;{% endif %}{% if field_style.opacity is defined %}opacity:{{ field_style.opacity }};{% endif %}{% if field_style.background_color is defined %}background-color:{{ field_style.background_color }};{% endif %}{% if field_style.padding_mm is defined %}padding:{{ field_style.padding_mm }}mm;{% endif %}"{% endif %}>
            {% if field.emphasis != 'title' %}<span class="estimate-cover-label">{{ field.label }}</span>{% endif %}
            <span class="estimate-cover-value">{{ field.value }}</span>
          </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="estimate-cover-field estimate-cover-field-title">
          <span class="estimate-cover-value">{{ ctx.project_summary.project_name }}</span>
        </div>
      {% endif %}
    </div>
    {% for field in ctx.cover.fields or [] %}
      {% if field.value is not none and field.geometry %}
      {% set geometry = field.geometry %}
      {% set field_style = field.style or {} %}
      <div class="estimate-cover-field estimate-cover-field-{{ field.emphasis or 'metadata' }}{% if field_style %} estimate-cover-field-styled{% endif %}" data-cover-key="{{ field.key }}" style="position:absolute;left:{{ geometry.x_pct }}%;top:{{ geometry.y_pct }}%;width:{{ geometry.width_pct }}%;{% if geometry.height_pct is defined %}height:{{ geometry.height_pct }}%;{% endif %}z-index:{{ geometry.z_index }};{% if geometry.rotation_deg is defined and geometry.rotation_deg %}transform:rotate({{ geometry.rotation_deg }}deg);transform-origin:center;{% endif %}{% if field_style.font_family is defined %}font-family:{{ field_style.font_family | tojson | forceescape }};{% endif %}{% if field_style.font_size_pt is defined %}font-size:{{ field_style.font_size_pt }}pt;{% endif %}{% if field_style.font_weight is defined %}font-weight:{{ field_style.font_weight }};{% endif %}{% if field_style.italic is defined %}font-style:{{ 'italic' if field_style.italic else 'normal' }};{% endif %}{% if field_style.color is defined %}color:{{ field_style.color }};{% endif %}{% if field_style.alignment is defined %}text-align:{{ field_style.alignment }};{% elif field_style.text_align is defined %}text-align:{{ field_style.text_align }};{% endif %}{% if field_style.line_height is defined %}line-height:{{ field_style.line_height }};{% endif %}{% if field_style.letter_spacing_pt is defined %}letter-spacing:{{ field_style.letter_spacing_pt }}pt;{% elif field_style.letter_spacing_em is defined %}letter-spacing:{{ field_style.letter_spacing_em }}em;{% endif %}{% if field_style.opacity is defined %}opacity:{{ field_style.opacity }};{% endif %}{% if field_style.background_color is defined %}background-color:{{ field_style.background_color }};{% endif %}{% if field_style.padding_mm is defined %}padding:{{ field_style.padding_mm }}mm;{% endif %}">
        {% if field.emphasis != 'title' %}<span class="estimate-cover-label">{{ field.label }}</span>{% endif %}
        <span class="estimate-cover-value">{{ field.value }}</span>
      </div>
      {% endif %}
    {% endfor %}
  </section>
  {% endif %}
  <h1>{{ ctx.labels.title }}</h1>

  <div class="section-card section">
    <h2>{{ ctx.labels.project_summary }}</h2>
    <table class="qa-table">
      <tbody>
        <tr><th>{{ ctx.labels.project_name }}</th><td>{{ ctx.project_summary.project_name }}</td></tr>
        <tr><th>{{ ctx.labels.estimate_type }}</th><td>{{ ctx.project_summary.estimate_type }}</td></tr>
        <tr><th>{{ ctx.labels.client_name }}</th><td>{{ ctx.project_summary.client_name }}</td></tr>
        <tr><th>{{ ctx.labels.estimate_id }}</th><td>{{ ctx.project_summary.estimate_id }}</td></tr>
        <tr><th>{{ ctx.labels.export_revision }}</th><td>{{ ctx.project_summary.export_revision }}</td></tr>
        <tr><th>{{ ctx.labels.generated_date }}</th><td>{{ ctx.project_summary.generated_date }}</td></tr>
        <tr><th>{{ ctx.labels.estimate_creator }}</th><td>{{ ctx.project_summary.estimate_creator }}</td></tr>
      </tbody>
    </table>
  </div>

  <div class="section-card section">
    <h2>{{ ctx.labels.executive_cost_summary }}</h2>
    <table class="qa-table">
      <tbody>
        {% include '_pricing_summary_rows.j2' %}
        <tr><th>{{ ctx.labels.maintenance_cost_monthly_annual }}</th><td class="num">{{ ctx.executive_display.maintenance_cost_display }}</td></tr>
        <tr><th>{{ ctx.labels.development_period }}</th><td class="num">{{ ctx.executive_display.development_period_display }}</td></tr>
      </tbody>
    </table>
    {% if ctx.pricing_summary.has_discount %}
    <p class="muted" style="white-space: pre-wrap; margin-top: 8pt;">*{{ ctx.pricing_summary.campaign_terms_title }}

{{ ctx.pricing_summary.campaign_terms }}</p>
    {% endif %}
  </div>

  <div class="section-card section">
    <h2>{{ ctx.labels.questionnaire }}</h2>
    {% if ctx.questionnaire_sections %}
      {% for section in ctx.questionnaire_sections %}
        <h3>{{ section.title }}</h3>
        <table class="qa-table">
          <tbody>
            {% for field in section.fields %}
              <tr><th>{{ field.label }}</th><td>{{ field.value }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% endfor %}
    {% else %}
      <p class="muted">{{ ctx.labels.none }}</p>
    {% endif %}
  </div>

  {% if ctx.extracted.functional_requirements or ctx.extracted.non_functional_requirements or ctx.extracted.modules or ctx.extracted.user_roles or ctx.extracted.external_systems %}
    {% if ctx.extracted.functional_requirements %}
  <div class="section-card section">
    <h2>{{ ctx.labels.functional_requirements }}</h2>
    <ul>{% for item in ctx.extracted.functional_requirements %}<li>{{ item }}</li>{% endfor %}</ul>
  </div>
    {% endif %}
    {% if ctx.extracted.non_functional_requirements %}
  <div class="section-card section">
    <h2>{{ ctx.labels.non_functional_requirements }}</h2>
    <ul>{% for item in ctx.extracted.non_functional_requirements %}<li>{{ item }}</li>{% endfor %}</ul>
  </div>
    {% endif %}
    {% if ctx.extracted.modules %}
  <div class="section-card section">
    <h2>{{ ctx.labels.modules }}</h2>
    <ul>{% for item in ctx.extracted.modules %}<li>{{ item }}</li>{% endfor %}</ul>
  </div>
    {% endif %}
    {% if ctx.extracted.user_roles %}
  <div class="section-card section">
    <h2>{{ ctx.labels.user_roles }}</h2>
    <ul>{% for item in ctx.extracted.user_roles %}<li>{{ item }}</li>{% endfor %}</ul>
  </div>
    {% endif %}
    {% if ctx.extracted.external_systems %}
  <div class="section-card section">
    <h2>{{ ctx.labels.external_systems }}</h2>
    <ul>{% for item in ctx.extracted.external_systems %}<li>{{ item }}</li>{% endfor %}</ul>
  </div>
    {% endif %}
  {% else %}
  <div class="section-card section">
    <h2>{{ ctx.labels.functional_requirements }}</h2>
    <p class="muted">{{ ctx.labels.none }}</p>
  </div>
  {% endif %}

  <div class="section-card section">
    <h2>{{ ctx.labels.feature_items }}</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>{{ ctx.labels.feature_name }}</th>
          <th>{{ ctx.labels.feature_description }}</th>
          <th>{{ ctx.labels.feature_phase }}</th>
          <th>{{ ctx.labels.feature_role }}</th>
          <th class="num">{{ ctx.labels.feature_hours }}</th>
          <th class="num">{{ ctx.labels.feature_days }}</th>
        </tr>
      </thead>
      <tbody>
        {% for item in ctx.feature_items %}
          <tr>
            <td>{{ item.name }}</td>
            <td>{{ item.description }}</td>
            <td>{{ item.phase }}</td>
            <td>{{ item.role }}</td>
            <td class="num">{{ format_hours(item.hours) }}</td>
            <td class="num">{{ format_effort_days(item.hours) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="section-card section">
    <h2>{{ ctx.labels.effort_summary }}</h2>
    <table class="qa-table">
      <tbody>
        <tr><th>{{ ctx.labels.total_hours }}</th><td class="num">{{ format_hours(ctx.effort_summary.total_hours) }}</td></tr>
        <tr><th>{{ ctx.labels.total_days }}</th><td class="num">{{ format_effort_days(ctx.effort_summary.total_hours) }}</td></tr>
        <tr><th>{{ ctx.labels.estimated_duration }}</th><td class="num">{{ format_person_days(ctx.effort_summary.estimated_duration_days) }} {{ ctx.labels.days }}</td></tr>
      </tbody>
    </table>
  </div>

  {% if ctx.gantt and ctx.gantt.tasks %}
  <div class="section-card section">
    <h2>{{ ctx.labels.gantt_title }}</h2>
    <p class="note">{{ ctx.labels.gantt_assumption }}</p>
    <table class="qa-table">
      <tbody>
        <tr><th>{{ ctx.labels.gantt_project_start }}</th><td>{{ ctx.gantt.project_start_date }}</td></tr>
        <tr><th>{{ ctx.labels.gantt_project_end }}</th><td>{{ ctx.gantt.project_end_date }}</td></tr>
        <tr><th>{{ ctx.labels.gantt_total_working_days }}</th><td class="num">{{ ctx.gantt.total_working_days }}</td></tr>
      </tbody>
    </table>
    {% if ctx.gantt_chart_svg %}
    <div class="gantt-chart">{{ ctx.gantt_chart_svg | safe }}</div>
    {% endif %}
  </div>
  {% endif %}

  <div class="section-card section">
    <h2>{{ ctx.labels.nrc_detailed }}</h2>
    <table class="data-table">
      <thead>
        <tr><th>{{ ctx.labels.category }}</th><th>{{ ctx.labels.item }}</th><th class="num">{{ ctx.labels.cost }}</th></tr>
      </thead>
      <tbody>
        {% for row in ctx.calculation.nrc_line_items %}
          <tr>
            <td>{{ row.category }}</td>
            <td>{{ row.item }}</td>
            <td class="num">{{ format_currency(row.cost_jpy) }}</td>
          </tr>
        {% endfor %}
        <tr class="total-row">
          <th colspan="2">{{ ctx.labels.nrc_total }}</th>
          <td class="num">{{ format_currency(ctx.executive_summary.nrc_total_jpy) }}</td>
        </tr>
      </tbody>
    </table>
    <p class="muted">{{ ctx.labels.nrc_total_formula }}</p>
  </div>

  <div class="section-card section">
    <h2>{{ ctx.labels.rc_detailed }}</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>{{ ctx.labels.category }}</th>
          <th>{{ ctx.labels.service_description }}</th>
          <th class="num">{{ ctx.labels.monthly }}</th>
          <th class="num">{{ ctx.labels.annual }}</th>
        </tr>
      </thead>
      <tbody>
        {% include '_rc_breakdown_detailed.j2' %}
      </tbody>
    </table>
  </div>

  <div class="section-card section">
    <h2>{{ ctx.labels.estimate_exclusions }}</h2>
    {% if ctx.extracted.estimate_exclusions %}
      <div class="req-group">
        <ul>{% for item in ctx.extracted.estimate_exclusions %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
    {% else %}
      <p class="muted">{{ ctx.labels.none }}</p>
    {% endif %}
  </div>

  <div class="section-card section">
    <h2>{{ ctx.labels.approval }}</h2>
    <p><strong>{{ ctx.labels.prepared_by }}:</strong> {{ ctx.labels.prepared_by_value }}</p>
    <p><strong>{{ ctx.labels.reviewed_by }}:</strong></p>
    <div class="signature-line"></div>
    <p><strong>{{ ctx.labels.approved_by }}:</strong></p>
    <div class="signature-line"></div>
    <p><strong>{{ ctx.labels.approval_date }}:</strong></p>
    <div class="signature-line"></div>
  </div>
</body>
</html>
