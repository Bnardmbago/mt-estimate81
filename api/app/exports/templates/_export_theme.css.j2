:root {
  --export-primary: #1E3A5F;
  --export-primary-light: #E8EEF4;
  --export-surface: #F8FAFC;
  --export-border: #E2E8F0;
  --export-border-light: #CBD5E1;
  --export-text: #1E293B;
  --export-text-body: #1E293B;
  --export-muted: #64748B;
  --export-accent: #2563EB;
  --export-text-on-primary: #FFFFFF;
  /* Legacy aliases */
  --export-blue-primary: var(--export-primary);
  --export-blue-light: var(--export-primary-light);
  --export-yellow-section: var(--export-surface);
  --export-yellow-total: var(--export-primary-light);
}
